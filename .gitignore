# Segredos — NUNCA commitar. Se algum destes já estiver rastreado,
# `git rm --cached <arquivo>` primeiro: .gitignore não afeta arquivo já rastreado.
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
service-account*.json

# Config de agente/MCP com chaves embutidas
.claude.json
.mcp.json

# Config pessoal por-máquina (paths/permissões locais). Não distribuir.
.claude/settings.local.json

node_modules/
out/
*.log

# Lixo de SO / editor
.DS_Store
Thumbs.db
desktop.ini
._*

# Bytecode Python
__pycache__/
*.pyc

# Output de build
.next/
dist/
build/
.cache/
coverage/

# Projetos independentes hospedados nesta pasta (têm repo/destino próprio).
# Esta biblioteca é só de skills/squads/agents — output de projeto não entra aqui.
# Ancorados na raiz (/) — senão `aiox/` casaria o squad versionado AIOX (core.ignorecase=true).
/aiox/
/ai-website-cloner/

# Temporários de verificação
.tmp/
